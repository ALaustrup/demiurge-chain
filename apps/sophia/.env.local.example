// Copy this file to .env.local and fill in your values
// DO NOT commit .env.local to version control

// Development Environment Variables
NEXT_PUBLIC_APP_NAME=sophia
NEXT_PUBLIC_APP_URL=http://localhost:3003

// Authentication (QOR Auth Service)
NEXT_PUBLIC_QOR_AUTH_URL=http://localhost:3001
QOR_AUTH_SECRET=dev_secret_change_in_production

// Blockchain RPC (Demiurge Framework)
NEXT_PUBLIC_DEMIURGE_RPC_URL=http://localhost:9944
DEMIURGE_WS_URL=ws://localhost:9944

// API Configuration
NEXT_PUBLIC_API_URL=http://localhost:3003/api
API_SECRET=dev_secret_change_in_production

// AI/Sophia Configuration
ANTHROPIC_API_KEY=sk-ant-...  // Get from console.anthropic.com
OPENAI_API_KEY=sk-...          // Get from platform.openai.com
NEXT_PUBLIC_DEFAULT_AI_MODEL=claude-3-5-sonnet-20241022

// Security
JWT_SECRET=dev_secret_change_in_production
SESSION_SECRET=dev_secret_change_in_production

// Feature Flags
NEXT_PUBLIC_ENABLE_SOPHIA=true
NEXT_PUBLIC_ENABLE_WALLET=true
NEXT_PUBLIC_ENABLE_GAMES=true
NEXT_PUBLIC_ENABLE_NFT_PORTAL=true
