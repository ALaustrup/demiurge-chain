# Demiurge Hub - Production Environment
# Generated: 2026-01-25

# Application
NODE_ENV=production
PORT=3000

# API Endpoints
NEXT_PUBLIC_QOR_AUTH_URL=https://demiurge.cloud/api/v1
NEXT_PUBLIC_DEMIURGE_RPC_URL=https://rpc.demiurge.cloud
NEXT_PUBLIC_BLOCKCHAIN_RPC_URL=https://rpc.demiurge.cloud
NEXT_PUBLIC_BLOCKCHAIN_WS_URL=wss://rpc.demiurge.cloud/ws

# Feature Flags
NEXT_PUBLIC_USE_MOCK_BLOCKCHAIN=false
NEXT_PUBLIC_ENABLE_STAKING=true
NEXT_PUBLIC_ENABLE_NFT_PORTAL=true

# URLs
NEXT_PUBLIC_NFT_PORTAL_URL=https://demiurge.cloud/games
NEXT_PUBLIC_MARKETING_URL=https://demiurge.cloud

# Database (shared with QOR Auth PostgreSQL)
# DATABASE_URL is supplied at deploy time. The committed value held the
# qor_auth database password; it was removed on 2026-09-14 and must be rotated.

# Chain Config
NEXT_PUBLIC_CHAIN_NAME=Demiurge
NEXT_PUBLIC_CHAIN_TOKEN_SYMBOL=CGT
NEXT_PUBLIC_CHAIN_TOKEN_DECIMALS=2
